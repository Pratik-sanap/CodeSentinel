{
  "name": "reviewai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm exec tsc -b tsconfig.json",
    "dev": "pnpm --filter @reviewai/dashboard dev",
    "lint": "pnpm exec eslint .",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm exec tsc -b tsconfig.json --pretty false",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "vitest": "^3.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}